# Set to "false" once your Spring Boot backend is running and reachable.
# While "true", the app runs entirely on a local mock database (localStorage)
# so you can demo every screen with zero backend.
VITE_USE_MOCK=true

# Only needed when VITE_USE_MOCK=false and not using the Vite dev proxy.
VITE_API_BASE_URL=http://localhost:8080/api

# Razorpay key id (test mode key starts with rzp_test_) — only needed
# once you flip `mock: false` in src/pages/resident/CurrentBill.jsx
VITE_RAZORPAY_KEY_ID=
